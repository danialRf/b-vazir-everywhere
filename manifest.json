{
  "manifest_version": 3,
  "name": "B Vazir Everywhere",
  "version": "2.0.0",
  "description": "Apply bundled Vazir to all website text with global and per-site controls.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["fonts/Vazir-Regular.woff2", "fonts/Vazir-Bold.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "B Vazir Everywhere",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["font.css"],
      "js": ["font-enforcer.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shadow-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "b-vazir-everywhere@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
